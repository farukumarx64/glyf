  "root": {
    "id": "root",
    "type": "column",
    "children": [
      {
        "id": "heading",
        "type": "heading",
        "level": 2,
        "text": "Controls and data"
      },
      {
        "id": "note",
        "type": "input",
        "kind": "text",
        "bind": "note",
        "label": "Note"
      },
      {
        "id": "count",
        "type": "input",
        "kind": "number",
        "bind": "count",
        "label": "Count"
      },
      {
        "id": "count-value",
        "type": "stateValue",
        "bind": "count",
        "prefix": "Count: "
      },
      {
        "id": "note-value",
        "type": "stateValue",
        "bind": "note",
        "prefix": "Note: "
      },
      {
        "id": "toggle",
        "type": "toggle",
        "bind": "show",
        "label": "Show conditional content"
      },
      {
        "id": "condition",
        "type": "when",
        "bind": "show",
        "equals": true,
        "children": [
          {
            "id": "conditional-text",
            "type": "text",
            "text": "Conditional content is visible."
          }
        ]
      },
      {
        "id": "values-table",
        "type": "table",
        "dataset": "values",
        "editable": true
      },
      {
        "id": "bar-chart",
        "type": "chart",
        "kind": "bar",
        "dataset": "values",
        "x": "label",
        "y": "amount",
        "title": "bar chart"
      },
      {
        "id": "line-chart",
        "type": "chart",
        "kind": "line",
        "dataset": "values",
        "x": "label",
        "y": "amount",
        "title": "line chart"
      },
      {
        "id": "markdown",
        "type": "markdown",
        "text": "**Safe Markdown** and [Details](#details).\n\n![Disabled image](https://example.invalid/image.png)\n\n<img src=\"https://example.invalid/raw.png\" onerror=\"alert(1)\">\n\n[Rejected link](javascript:alert(1))\n\n```text\nWide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample Wide code sample \n```"
      },
      {
        "id": "progressive-table",
        "type": "table",
        "dataset": "progressive"
      },
      {
        "id": "details",
        "type": "heading",
        "level": 2,
        "text": "Details"
      }
    ]
  }
}
