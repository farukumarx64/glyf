{
  "name": "mosaic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "bun": "1.3.14"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "preinstall": "bun scripts/check-toolchain.mjs",
    "generate:validator": "node --import tsx scripts/generate-validator.ts",
    "dev": "bun run generate:validator && vite --host 127.0.0.1",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "bun run generate:validator && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "bun run generate:validator && vitest run",
    "test:viewer": "bun run build && playwright test",
    "benchmark": "bun run build && node --import tsx scripts/benchmark.ts",
    "profile": "bun run typecheck && node --import tsx scripts/profile.ts",
    "memory": "bun run build && node --import tsx scripts/memory.ts",
    "memory:native": "node --import tsx scripts/memory-native.ts",
    "test:watch": "bun run generate:validator && vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:example": "bun run generate:validator && node --import tsx scripts/validate-example.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run validate:example && bun run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
